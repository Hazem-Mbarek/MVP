# Copy this file to .env and fill in your actual values
# NEVER commit .env with real secrets to version control

# OpenRouter API Configuration
OPENROUTER_API_KEY=your-api-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-oss-120b

# Frontend exposure (for client-side API calls)
NEXT_PUBLIC_OPENROUTER_API_KEY=your-api-key-here
NEXT_PUBLIC_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
NEXT_PUBLIC_OPENROUTER_MODEL=openai/gpt-oss-120b
